#ifndef __RETRO_CORE_LAUNCHER_SHADRES_H
#define __RETRO_CORE_LAUNCHER_SHADRES_H

// --- Shaders Source Definitions (GLSL 330 Core Profile Compliance) ---
const char* vertex_shader_src = R"(
    #version 330 core
    layout(location = 0) in vec2 aPos;
    layout(location = 1) in vec2 aTexCoord;
    out vec2 TexCoord;
    void main() {
        TexCoord = aTexCoord;
        gl_Position = vec4(aPos.x, aPos.y, 0.0, 1.0);
    }
)";

// Encoder Fragment Pass
const char* encoder_fragment_src = R"(
    #version 330 core
    in vec2 TexCoord;
    out vec4 FragColor;
    uniform sampler2D uCoreTexture;
    uniform vec2 uEncodedResolution;
    uniform vec2 uCoreResolution;
    uniform int uMode;              // 0 = RF, 1 = Composite, 2 = Component, 3 = VGA
    uniform int uFrameCount;        // Track alternating frame index
    uniform int uSignalStandard;    // 0 = NTSC, 1 = PAL

    // RGB to YUV (PAL standard matrix)
    const mat3 RGB_TO_YUV = mat3(
        0.299, -0.14713,  0.615,
        0.587, -0.28886, -0.51499,
        0.114,  0.436,   -0.10001
    );

    // RGB to YIQ (NTSC standard matrix)
    const mat3 RGB_TO_YIQ = mat3(
        0.299,  0.5959,  0.2115,
        0.587, -0.2746, -0.5227,
        0.114, -0.3213,  0.3112
    );

    const float NTSC_SAMPLES_PER_LINE = 2048.0;
    const float PI = 3.14159265359;

    void main() {
        vec2 uv = TexCoord;
        uv.y = 1.0f - uv.y;

        vec3 rgb_color = texture(uCoreTexture, uv).rgb;

        switch(uMode) {
            case 0:
            case 1:                
                // RF & Composite Paths

                float samplesPerLine = uEncodedResolution.x; // Automatically tracks upscales (e.g. 2048)
                float virtualX = TexCoord.x * samplesPerLine;


                // 2. Dynamically calculate wavelength cycles (N pixels per wave cycle)
                float wavePixelPeriod = 4.0;
                if (uMode == 0) {
                    wavePixelPeriod = 6.0;
                } else if (uSignalStandard == 1) {
                    wavePixelPeriod = 3.0;  
                }

                // Resolution-Independent Frequency Assignment
                float frequency = 0.0;
                if (uSignalStandard == 1) { // PAL Standard Presets
                    // Detuned PAL Composite from 1.5707963 to 1.592 to break the 2D grid lock.
                    // PAL RF retains 1.621 to prevent the specific wide-window checkerboard artifact.
                    frequency = (uMode == 0) ? 1.621 : 1.592; 
                } else { // NTSC Standard Presets
                    frequency = (uMode == 0) ? 1.0471975 : 1.5707963; 
                }

                float temporalPhase = float(uFrameCount % 2) * PI;

                if (uSignalStandard == 1 && uMode == 1) {
                    temporalPhase += float(uFrameCount) * (PI * 0.5);
                }
                
                // --- UNIVERSAL RF PHASE JITTER CROSS-TALK ---
                float rfNoise = 0.0;
                if (uMode == 0) {
                    // Combines a slow scrolling vertical wave (hum bar) with a faster high-frequency jitter
                    float slowWave = sin(TexCoord.y * 8.0 + float(uFrameCount) * 0.05) * 0.8;
                    float fastJitter = sin(TexCoord.y * 120.0 - float(uFrameCount) * 0.4) * 0.3;
                    rfNoise = (slowWave + fastJitter) * 0.75;
                }

                float angle = ((virtualX + rfNoise) * frequency) + temporalPhase;
                float composite = 0.0;

                if (uSignalStandard == 1) { // PAL PATH
                    vec3 yuv_color = RGB_TO_YUV * rgb_color;
                    float scanlineIndex = floor(TexCoord.y * uEncodedResolution.y);
                    float lineAlternatePhase = (mod(scanlineIndex, 2.0) == 1.0) ? -1.0 : 1.0;

                    // Swap the phase multiplier state every alternating frame
                    float frameToggle = (uFrameCount % 2 == 1) ? -1.0 : 1.0;
                    lineAlternatePhase *= frameToggle;
                    
                    composite = yuv_color.x + yuv_color.y * sin(angle) + (yuv_color.z * lineAlternatePhase) * cos(angle);
                } else { // NTSC PATH
                    vec3 yiq_color = RGB_TO_YIQ * rgb_color;
                    composite = yiq_color.x + yiq_color.y * sin(angle) + yiq_color.z * cos(angle);
                }

                // Step 1: Advance the spatial seed coordinates using the current frame offset
                float dynamicSeed = float(uFrameCount) * 0.05;
                vec2 noiseCoords = TexCoord + vec2(dynamicSeed, -dynamicSeed);
                    
                // Step 2: High-frequency fractional sine wave hash for grain texture
                float pseudoRandomNoise = fract(sin(dot(noiseCoords, vec2(12.9898, 78.233))) * 43758.5453);
                    
                // Step 3: Center the noise around 0.0 and mix a subtle 4% signal amplitude degradation
                if (uMode == 0) {
                    composite += (pseudoRandomNoise - 0.5) * 0.08;
                } else {
                    composite += (pseudoRandomNoise - 0.5) * 0.03;
                }

                FragColor = vec4(composite, 0.0, 0.0, 1.0);
                break;
            case 2:
                // Component            
                if(uSignalStandard == 0) {
                    // NTSC
                    FragColor = vec4(RGB_TO_YIQ * rgb_color, 1.0);
                } else {
                    // PAL
                    FragColor = vec4(RGB_TO_YUV * rgb_color, 1.0);
                }
                break;
            case 3:
            default:
                // VGA mode
                FragColor = vec4(rgb_color, 1.0);
                break;
            
        }
    }
)";

// Decoder Fragment Pass
const char* decoder_fragment_src = R"(
    #version 330 core
    in vec2 TexCoord;
    out vec4 FragColor;

    uniform int uSignalStandard;    // 0 = NTSC, 1 = PAL
    uniform int uFrameCount;        // Track alternating frame index
    uniform int uMode;              // 0 = RF, 1 = Composite, 2 = Component, 3 = VGA
    uniform vec2 uDistortion;
    uniform vec2 uEncodedResolution;
    uniform sampler2D uEncodedTexture;
    
    // NTSC
    const mat3 YIQ_TO_RGB = mat3(
        1.0,     1.0,     1.0,
        0.9563, -0.2721, -1.107,
        0.621,  -0.6474,  1.7046
    );

    // PAL
    const mat3 YUV_TO_RGB = mat3(
        1.0,      1.0,     1.0,
        0.0,     -0.39465, 2.03211,
        1.13983, -0.58060, 0.0
    );

    const float NTSC_SAMPLES_PER_LINE = 2048.0;
    const float PI = 3.14159265359;

    vec3 decodeSignalChannel(vec2 coords) {
            float samplesPerLine = uEncodedResolution.x; // Automatically tracks upscales (e.g. 2048)

            // RF & Composite Settings
            float virtualX = coords.x * samplesPerLine;
            float texelX = 1.0 / samplesPerLine;
            float texelY = 1.0 / uEncodedResolution.y;

            // Match the encoder phase shift logic exactly
            float temporalPhase = float(uFrameCount % 2) * PI;

            // --- RF DYNAMIC TUNING NOISE OVERLAY ---
            float rfNoise = 0.0;
            if (uMode == 0) {
                // Combines a slow scrolling vertical wave (hum bar) with a faster high-frequency jitter
                float slowWave = sin(TexCoord.y * 8.0 + float(uFrameCount) * 0.05) * 0.8;
                float fastJitter = sin(TexCoord.y * 120.0 - float(uFrameCount) * 0.4) * 0.3;
                rfNoise = (slowWave + fastJitter) * 0.75;
            }

            // Apply identical coordinate shifting to trace the signal
            float distortedVirtualX = virtualX + rfNoise;

            // ==========================================================
            // DYNAMIC RESOLUTION FREQUENCY RESOLVER
            // ==========================================================
            float wavePixelPeriod = 4.0;
            if (uMode == 0) {
                wavePixelPeriod = 6.0;
            } else if (uSignalStandard == 1) {
                wavePixelPeriod = 3.0;  
            }

            float frequency = (2.0 * PI) / wavePixelPeriod;
            if (uSignalStandard == 1) {
                // Synchronized with the detuned PAL frequency matrix profiles
                frequency = (uMode == 0) ? 1.621 : 1.592;
            }

            float centerAngle = (distortedVirtualX * frequency) + temporalPhase;

            float scanlineIndex = floor(coords.y * uEncodedResolution.y);

            // ==========================================================
            // 1. CHROMINANCE DEMODULATION LOOP (Runs First)
            // ==========================================================
            int chromaWidth = int(wavePixelPeriod * 5.0);
            chromaWidth = (uMode == 0) ? 12 : ((uSignalStandard == 1) ? 4 : 5);
    

            float CH_U = 0.0; 
            float CH_V = 0.0;
            float CH_V_Prev = 0.0; // Line ABOVE (-1)
            float CH_V_Next = 0.0; // Dynamic tracking register for adjacent line low-pass
            float chromaWeights = 0.0;

            float targetY_Prev = clamp(coords.y - texelY * 2, 0.0, 1.0);
            float targetY_Next = clamp(coords.y + texelY * 2, 0.0, 1.0);

            // Determine the active temporal frame toggle sign
            float frameToggle = (uFrameCount % 2 == 1) ? -1.0 : 1.0;

            // Apply the frame toggle uniformly across all 3 line-phase equations
            float lineAlternatePhase = 1.0;
            if(uSignalStandard == 1) {
                // PAL
                lineAlternatePhase  = ((mod(scanlineIndex, 2.0) == 1.0) ? -1.0 : 1.0) * frameToggle;
            }

            float prevLineAlternatePhase = ((mod(scanlineIndex - 1.0, 2.0) == 1.0) ? -1.0 : 1.0) * ((uSignalStandard == 1) ? frameToggle : 1.0);
            float nextLineAlternatePhase = ((mod(scanlineIndex + 1.0, 2.0) == 1.0) ? -1.0 : 1.0) * ((uSignalStandard == 1) ? frameToggle : 1.0);

            for (int i = -chromaWidth; i <= chromaWidth; i++) {
                float offsetUV_X = clamp(coords.x + float(i) * texelX, 0.0, 1.0);
                float sampleVirtualX = distortedVirtualX + float(i);
                float angle = (sampleVirtualX * frequency) + temporalPhase;

                float distanceRatio = float(i) / float(chromaWidth);
                float windowWeight = 0.5 * (1.0 + cos(PI * distanceRatio));

                float signal = texture(uEncodedTexture, vec2(offsetUV_X, coords.y)).r;

                float stepPixels = int(wavePixelPeriod * 0.5);

                CH_U += (signal * sin(angle)) * windowWeight;
                CH_V += (signal * cos(angle) * lineAlternatePhase) * windowWeight;

                if (uSignalStandard == 1) {
                    float signalPrev = texture(uEncodedTexture, vec2(offsetUV_X, targetY_Prev)).r;
                    float signalNext = texture(uEncodedTexture, vec2(offsetUV_X, targetY_Next)).r;
            
                    CH_V_Prev += (signalPrev * cos(angle) * prevLineAlternatePhase) * windowWeight;
                    CH_V_Next += (signalNext * cos(angle) * nextLineAlternatePhase) * windowWeight;
                }

                chromaWeights += windowWeight;
            }

            // Scale chroma components by 2.0 to restore baseline carrier energy
            // and multiply by our saturation scalar control
            
            float saturation = (uMode == 0) ? 0.8 : 0.9;

            float baseU = (CH_U / chromaWeights) * 2.0;
            float baseV = (CH_V / chromaWeights) * 2.0;

            if (uSignalStandard == 1) {
                float baseV_Prev = (CH_V_Prev / chromaWeights) * 2.0;
                float baseV_Next = (CH_V_Next / chromaWeights) * 2.0;
                // 3-Line Comb Filter Blend: Center gets 50% weight, top/bottom get 25% each
                
                baseV = (baseV * 0.5) + (baseV_Prev * 0.25) + (baseV_Next * 0.25);
            }

            // ==========================================================
            // 2. MATHEMATICAL CHROMA-SUBTRACTION LUMA FILTER
            // ==========================================================
            
            float normY = 0.0;
            float testY = 0.0;

            float sigCenter = texture(uEncodedTexture, vec2(coords.x, coords.y)).r;
            float stepPixels = int(wavePixelPeriod * 0.5); 

            if (uSignalStandard == 1) { 
                // PAL PATH

                stepPixels = (uMode == 0) ? 2 : 1; 
                
                // Allocate coordinates for 5 symmetric horizontal taps
                float uvLeft2  = clamp(coords.x - (float(stepPixels * 2) * texelX), 0.0, 1.0);
                float uvLeft1  = clamp(coords.x - (float(stepPixels)     * texelX), 0.0, 1.0);
                float uvRight1 = clamp(coords.x + (float(stepPixels)     * texelX), 0.0, 1.0);
                float uvRight2 = clamp(coords.x + (float(stepPixels * 2) * texelX), 0.0, 1.0);
                
                float sigLeft2  = texture(uEncodedTexture, vec2(uvLeft2,  coords.y)).r;
                float sigLeft1  = texture(uEncodedTexture, vec2(uvLeft1,  coords.y)).r;
                float sigRight1 = texture(uEncodedTexture, vec2(uvRight1, coords.y)).r;
                float sigRight2 = texture(uEncodedTexture, vec2(uvRight2, coords.y)).r;

                // Calculate carrier tracking angles across all 5 tap positions
                float angleCenter = (distortedVirtualX * frequency) + temporalPhase;
                float angleLeft2  = ((distortedVirtualX - float(stepPixels * 2)) * frequency) + temporalPhase;
                float angleLeft1  = ((distortedVirtualX - float(stepPixels))     * frequency) + temporalPhase;
                float angleRight1 = ((distortedVirtualX + float(stepPixels))     * frequency) + temporalPhase;
                float angleRight2 = ((distortedVirtualX + float(stepPixels * 2)) * frequency) + temporalPhase;

                // Reconstruct independent subcarrier values
                float subcarrierCenter = baseU * sin(angleCenter) + (baseV * lineAlternatePhase) * cos(angleCenter);
                float subcarrierLeft2  = baseU * sin(angleLeft2)  + (baseV * lineAlternatePhase) * cos(angleLeft2);
                float subcarrierLeft1  = baseU * sin(angleLeft1)  + (baseV * lineAlternatePhase) * cos(angleLeft1);
                float subcarrierRight1 = baseU * sin(angleRight1) + (baseV * lineAlternatePhase) * cos(angleRight1);
                float subcarrierRight2 = baseU * sin(angleRight2) + (baseV * lineAlternatePhase) * cos(angleRight2);

                // Strip subcarriers to find pure localized luminance values
                float yCenter = sigCenter - subcarrierCenter;
                float yLeft2  = sigLeft2  - subcarrierLeft2;
                float yLeft1  = sigLeft1  - subcarrierLeft1;
                float yRight1 = sigRight1 - subcarrierRight1;
                float yRight2 = sigRight2 - subcarrierRight2;

                // Apply a high-order 5-tap binomial distribution matrix [1/16, 4/16, 6/16, 4/16, 1/16]
                normY = (yLeft2 * 0.0625) + (yLeft1 * 0.25) + (yCenter * 0.375) + (yRight1 * 0.25) + (yRight2 * 0.0625);
    
            } else {
                // NTSC PATH
                
                int stepPixels = int(wavePixelPeriod * 0.5); // Always exactly 2 pixels in NTSC

                float sigLeft   = texture(uEncodedTexture, vec2(clamp(coords.x - (float(stepPixels) * texelX), 0.0, 1.0), coords.y)).r;
                float sigRight  = texture(uEncodedTexture, vec2(clamp(coords.x + (float(stepPixels) * texelX), 0.0, 1.0), coords.y)).r;
                normY = (sigCenter * 0.5) + (sigLeft * 0.25) + (sigRight * 0.25);
    
                testY = normY;
            }

            // Apply saturation multipliers to final output chroma paths
            float normU = baseU * saturation;
            float normV = baseV * saturation;

            // --- 3. PAL Hardware Delay-Line Filter Emulation ---
            if (uSignalStandard == 1) {
                // Sample the adjacent vertical line from the composite canvas
            //    float texelY = 1.0 / uEncodedResolution.y;
            //    float signalNextLine = texture(uEncodedTexture, vec2(coords.x, clamp(coords.y + texelY, 0.0, 1.0))).r;
                
                // Extract the vertical chroma variance to cancel out crawling phase errors
            //    float angleNext = (virtualX * frequency) + temporalPhase;
            //   float chromaVNext = signalNextLine * cos(angleNext) * (-lineAlternatePhase);
                
                // Blend 50% of the adjacent line color data into the current matrix calculation
            //    normV = (normV + (chromaVNext * 2.0 * saturation)) * 0.5;

                float normV_Next = (CH_V_Next / chromaWeights) * 2.0 * saturation;
                // Average the two fully filtered, low-passed chroma rows together
                //normV = (normV + normV_Next) * 0.5;
            }

            return vec3(testY);

            vec3 decodedVector = vec3(normY, normU, normV);
            return vec3((uSignalStandard == 1 ? YUV_TO_RGB * decodedVector : YIQ_TO_RGB * decodedVector));
    }

    void main() {
        vec3 rgb = vec3(0.0);

        vec2 chroma_abberation = uDistortion * 0.5;

        switch(uMode) {
            case 0:
            case 1:
                // RF & Composite
                rgb.r = decodeSignalChannel(TexCoord + chroma_abberation).r;
                rgb.g = decodeSignalChannel(TexCoord).g;
                rgb.b = decodeSignalChannel(TexCoord - chroma_abberation).b;

                break;
            case 2:
                // Component
                {
                    const vec3 saturaton = vec3(1.0, 0.95, 0.95);

                    if(uSignalStandard == 0) {
                        // NTSC
                        rgb.r = (YIQ_TO_RGB * (texture(uEncodedTexture, TexCoord + chroma_abberation).rgb * saturaton)).r;
                        rgb.g = (YIQ_TO_RGB * (texture(uEncodedTexture, TexCoord).rgb * saturaton)).g;
                        rgb.b = (YIQ_TO_RGB * (texture(uEncodedTexture, TexCoord - chroma_abberation).rgb * saturaton)).b;
                    } else {
                        // PAL
                        rgb.r = (YUV_TO_RGB * (texture(uEncodedTexture, TexCoord + chroma_abberation).rgb * saturaton)).r;
                        rgb.g = (YUV_TO_RGB * (texture(uEncodedTexture, TexCoord).rgb * saturaton)).g;
                        rgb.b = (YUV_TO_RGB * (texture(uEncodedTexture, TexCoord - chroma_abberation).rgb * saturaton)).b;
                    }
                }
                break;
            default:
                // VGA mode
                rgb.r = texture(uEncodedTexture, TexCoord + chroma_abberation).r; 
                rgb.g = texture(uEncodedTexture, TexCoord).g;
                rgb.b = texture(uEncodedTexture, TexCoord - chroma_abberation).b;
                break;
        }

        FragColor = vec4(rgb, 1.0);
    }
)";

// History Fragment Pass
const char* history_fragment_src = R"(
    #version 330 core
    in vec2 TexCoord;
    out vec4 FragColor;
    uniform vec3 uDecayCoefficients;
    uniform sampler2D uDecodedTexture;
    uniform sampler2D uHistoryTexture;
    
    void main() {
        vec3 currentColor = texture(uDecodedTexture, TexCoord).rgb;
        vec3 historyColor = texture(uHistoryTexture, TexCoord).rgb;
    
        // Smoothly blend new signal data with lingering trail
        vec3 accumulated = max(currentColor, historyColor * uDecayCoefficients);
    
        FragColor = vec4(accumulated, 1.0);
    }
)";

// Present Fragment Pass
const char* present_fragment_src = R"(
    #version 330 core
    in vec2 TexCoord;
    out vec4 fragColor;
    uniform int uMode; // 0 = RF, 1 = Composite, 2 = Component, 3 = VGA
    uniform sampler2D uDecodedTexture;
    uniform vec2 uDecodedResolution;
    uniform vec2 uOutResolution;

    vec2 res = vec2( uDecodedResolution.x/1.0, uDecodedResolution.y/1.0);

    // Hardness of scanline.
    //  -8.0 = soft
    // -16.0 = medium
    float hardScan = -16.0;

    // Hardness of pixels in scanline.
    // -2.0 = soft
    // -4.0 = hard
    float hardPix = -4.0;

    // Display warp.
    // 0.0 = none
    // 1.0/8.0 = extreme
    vec2 warp=vec2(0.0/64.0, 0.0/24.0); 

    // Amount of shadow mask.
    float maskDark = 0.35;
    float maskLight = 1.1;

    // Falloff shape.
    // 1.0  = exp(x)
    // 1.25 = in between
    // 2.0  = gaussian
    // 3.0  = more square
    float shape = 3.0;

    // Amp signal.
    float overdrive = 1.75;

    // sRGB to Linear.
    // Assuing using sRGB typed textures this should not be needed.
    float ToLinear1(float c){return(c<=0.04045)?c/12.92:pow((c+0.055)/1.055,2.4);}
    vec3 ToLinear(vec3 c){return vec3(ToLinear1(c.r),ToLinear1(c.g),ToLinear1(c.b));}

    // Linear to sRGB.
    // Assuing using sRGB typed textures this should not be needed.
    float ToSrgb1(float c){return(c<0.0031308?c*12.92:1.055*pow(c,0.41666)-0.055);}
    vec3 ToSrgb(vec3 c){return vec3(ToSrgb1(c.r),ToSrgb1(c.g),ToSrgb1(c.b));}

    // Set to zero, or remove Test() if using this shader.
    #if 1
    vec3 Test(vec3 c){
        return c*(1.0/64.0)+c*c + c*0.65;
    }
    #else
    vec3 Test(vec3 c){return c;}
    #endif

    // Nearest emulated sample given floating point position and texel offset.
    // Also zero's off screen.
    vec3 Fetch(vec2 uv, vec2 off){
        // 1. Get total texture dimensions (Width, Height)
        vec2 texSize = uDecodedResolution;
        
        // 2. Convert pixel offset into normalized UV space
        vec2 uvOffset = off / texSize;
        
        // 3. Combine base position and offset
        vec2 targetUV = uv + uvOffset;
        
        // 4. Snap precisely to the center of the target texel
        vec2 centeredUV = (floor(targetUV * texSize) + 0.5) / texSize;

        if(centeredUV.x <= 0.0 || centeredUV.x >= 1.0 || centeredUV.y <= 0.0 || centeredUV.y >= 1.0) {
            return vec3(0.0, 0.0, 0.0);
        }

        vec3 color = texture(uDecodedTexture, centeredUV).rgb;
        return Test(ToLinear(color));
    }

    // Distance in emulated pixels to nearest texel.
    vec2 Dist(vec2 pos){
        pos = pos * res;
        return -((pos-floor(pos))-vec2(0.5));
    }

    // Try different filter kernels.
    float Gaus(float pos,float scale){
        return exp2(scale*pow(abs(pos),shape));
    }

    // 3-tap Gaussian filter along horz line.
    vec3 Horz3(vec2 pos,float off){
        vec3 b=Fetch(pos,vec2(-1.0, off));
        vec3 c=Fetch(pos,vec2( 0.0, off));
        vec3 d=Fetch(pos,vec2( 1.0, off));
        float dst=Dist(pos).x;
        // Convert distance to weight.
        float scale=hardPix;
        float wb=Gaus(dst-1.0,scale);
        float wc=Gaus(dst+0.0,scale);
        float wd=Gaus(dst+1.0,scale);
        // Return filtered sample.
        return (b*wb+c*wc+d*wd)/(wb+wc+wd);
    }

    // 5-tap Gaussian filter along horz line.
    vec3 Horz5(vec2 pos,float off){
        if(TexCoord.y > 0.5) {
            return Fetch(pos,vec2( 0.0, 0.0));
        }

        vec3 a=Fetch(pos,vec2(-2.0, off));
        vec3 b=Fetch(pos,vec2(-1.0, off));
        vec3 c=Fetch(pos,vec2( 0.0, off));
        vec3 d=Fetch(pos,vec2( 1.0, off));
        vec3 e=Fetch(pos,vec2( 2.0, off));
        float dst=Dist(pos).x;
        // Convert distance to weight.
        float scale=hardPix;
        float wa=Gaus(dst-2.0,scale);
        float wb=Gaus(dst-1.0,scale);
        float wc=Gaus(dst+0.0,scale);
        float wd=Gaus(dst+1.0,scale);
        float we=Gaus(dst+2.0,scale);
        // Return filtered sample.
        return (a*wa+b*wb+c*wc+d*wd+e*we)/(wa+wb+wc+wd+we);
    }

    // 7-tap Gaussian filter along horz line.
    vec3 Horz7(vec2 pos,float off)  {
        if(TexCoord.y > 0.5) {
            return Fetch(pos,vec2( 0.0, 0.0));
        }

        vec3 a=Fetch(pos,vec2(-3.0, off));
        vec3 b=Fetch(pos,vec2(-2.0, off));
        vec3 c=Fetch(pos,vec2(-1.0, off));
        vec3 d=Fetch(pos,vec2( 0.0, off));
        vec3 e=Fetch(pos,vec2( 1.0, off));
        vec3 f=Fetch(pos,vec2( 2.0, off));
        vec3 g=Fetch(pos,vec2( 3.0, off));
        float dst=Dist(pos).x;
        // Convert distance to weight.
        float scale=hardPix;
        float wa=Gaus(dst-3.0,scale);
        float wb=Gaus(dst-2.0,scale);
        float wc=Gaus(dst-1.0,scale);
        float wd=Gaus(dst+0.0,scale);
        float we=Gaus(dst+1.0,scale);
        float wf=Gaus(dst+2.0,scale);
        float wg=Gaus(dst+3.0,scale);
        // Return filtered sample.
        return (a*wa+b*wb+c*wc+d*wd+e*we+f*wf+g*wg)/(wa+wb+wc+wd+we+wf+wg);
    }

    // Return scanline weight.
    float Scan(vec2 pos,float off) {
        float dst = Dist(pos).y;
        return Gaus(dst + off, hardScan);
    }

    // Allow nearest three lines to effect pixel.
    vec3 Tri(vec2 pos) {
        vec3 a=Horz5(pos,-2.0);
        vec3 b=Horz7(pos,-1.0);
        vec3 c=Horz7(pos, 0.0);
        vec3 d=Horz7(pos, 1.0);
        vec3 e=Horz5(pos, 2.0);

        if(TexCoord.y > 0.5) {
            a = Fetch(pos,vec2( 0.0, 0.0));
            b = a;
            c = a;
            d = a;
            e = a;
        }

        float wa=Scan(pos,-2.0);
        float wb=Scan(pos,-1.0);
        float wc=Scan(pos, 0.0);
        float wd=Scan(pos, 1.0);
        float we=Scan(pos, 2.0);
        return (a*wa+b*wb+c*wc+d*wd+e*we)*overdrive;
    }

    // Distortion of scanlines, and end of screen alpha.
    vec2 Warp(vec2 pos) {
        pos = pos * 2.0 - 1.0;    
        pos *= vec2(1.0 + (pos.y * pos.y) * warp.x, 1.0 + (pos.x * pos.x) * warp.y);
        return pos * 0.5 + 0.5;
    }

    vec3 Mask(vec2 pos) {
        pos.x = fract(pos.x/3.0);
        vec3 mask = vec3(maskDark, maskDark, maskDark);
        if(pos.x<0.333) {
            mask.r = maskLight;
        } else if(pos.x<0.666) {
            mask.g = maskLight;
        } else {
            mask.b = maskLight;
        }
        return mask;
    }        

    void main() {
        vec2 pos = Warp(TexCoord);

        fragColor.rgb = Tri(pos) * Mask(TexCoord.xy * uOutResolution);
        fragColor.a = 1.0;  
        fragColor.rgb = ToSrgb(fragColor.rgb);

        //fragColor.rgb = texture(uDecodedTexture, pos).rgb;
    }
)";

#endif  // __RETRO_CORE_LAUNCHER_SHADRES_H